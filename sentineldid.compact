import CompactStandardLibrary;

// SentinelDID.compact
contract SentinelDID {
    // Internal Map - private storage for DID-to-KYC hash pairs
    Map<bytes32, bytes32> didNFTs;
    // Public Cell - tracks latest DID
    Cell<bytes32> public lastDid;

    // Event - announces new DIDs
    event DidIssued(bytes32 didId);

    // Mint DID - creates public DID, stores hash privately
    public function issueDid(bytes32 kycHash) returns (bytes32) {
        bytes32 didId = keccak256(kycHash, now()); // Unique public DID
        didNFTs.insert(didId, kycHash); // Private storage
        lastDid.write(didId); // Updates last DID
        emit DidIssued(didId); // Notifies publicly
        return didId; // Returns DID
    }

    // Check DID - public check
    public function hasDid(bytes32 didId) returns (bool) {
        return didNFTs.member(didId); // Verifies existence
    }

    // Total DIDs - public stat
    public function getDidCount() returns (uint64) {
        return didNFTs.size(); // Counts DIDs
    }

    // Last DID - public stat
    public function getLastDid() returns (bytes32) {
        return lastDid.read(); // Shows latest DID
    }

    // ZKProof - verifies KYC trait privately
    predicate isOver18(bytes32 kycHash, bytes proof) {
        assert(verifyZkProof(proof, kycHash)); // Checks proof - placeholder
    }

    // Verify Age - public ZKP call
    public function verifyAge(bytes32 didId, bytes proof) returns (bool) {
        bytes32 kycHash = didNFTs.lookup(didId); // Private lookup
        return isOver18(kycHash, proof); // Returns proof result
    }
}