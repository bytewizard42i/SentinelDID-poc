// SentinelDID.compact
contract SentinelDID {
    // Storage for NFTs - like a filing cabinet
    mapping(bytes32 => bytes32) public didNFTs; // didId => kycHash
    
    // Event to say “NFT made!”
    event DidIssued(bytes32 didId);
    
    // Mint a DID NFT - takes a hash, makes an ID
    public function issueDid(bytes32 kycHash) returns (bytes32) {
        // Make a unique ID from hash + time
        bytes32 didId = keccak256(kycHash, now());
        // Store the hash under that ID
        didNFTs[didId] = kycHash;
        // Shout “done” to the world
        emit DidIssued(didId);
        return didId; // Give ID back
    }
    
    // Placeholder ZKProof - proves stuff later
    predicate isValid(bytes32 kycHash, bytes proof) {
        assert(verifyZkProof(proof, kycHash)); // Fake for PoC
    }
}