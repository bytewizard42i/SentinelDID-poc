// New code after OG learning more about midnight

// SentinelDID.compact
contract SentinelDID {
    // Map ADT - like a filing cabinet with slots for each DID
    // Key is didId (unique ID), value is kycHash (secret code)
    Map<bytes32, bytes32> public didNFTs;

    // Event - yells “DID made!” to the world
    event DidIssued(bytes32 didId);

    // Mint a DID - takes a hash, makes an ID, stores it
    public function issueDid(bytes32 kycHash) returns (bytes32) {
        bytes32 didId = keccak256(kycHash, now()); // Unique ID from hash + time
        didNFTs.insert(didId, kycHash); // Pop it in the Map
        emit DidIssued(didId); // Shout it out
        return didId; // Give ID back
    }

    // Check if DID exists - handy for PoC demo!
    public function hasDid(bytes32 didId) returns (bool) {
        return didNFTs.member(didId); // True if didId’s in the Map
    }
}