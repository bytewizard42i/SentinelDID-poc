{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", "build/**"]
        },
        "start": {
            "cache": false,
            "persistent": true,
            "dependsOn": ["^build"]
        },
        "deploy": {
            "dependsOn": ["build"]
        },
        "verify": {
            "dependsOn": ["deploy"]
        }
    }
}