// SentinelDID.compact
contract SentinelDID {
    Map<bytes32, bytes32> didNFTs; // Private DID-to-KYC hash
    Cell<bytes32> public lastDid; // Public latest DID

    event DidIssued(bytes32 didId); // Announces DIDs

    public function issueDid(bytes32 kycHash) returns (bytes32) {
        bytes32 didId = keccak256(kycHash, now());
        didNFTs.insert(didId, kycHash);
        lastDid.write(didId);
        emit DidIssued(didId);
        return didId;
    }

    public function hasDid(bytes32 didId) returns (bool) {
        return didNFTs.member(didId);
    }

    public function getDidCount() returns (uint64) {
        return didNFTs.size();
    }

    public function getLastDid() returns (bytes32) {
        return lastDid.read();
    }

    predicate isOver18(bytes32 kycHash, bytes proof) {
        assert(verifyZkProof(proof, kycHash)); // Dummy ZKP
    }

    public function verifyAge(bytes32 didId, bytes proof) returns (bool) {
        bytes32 kycHash = didNFTs.lookup(didId);
        return isOver18(kycHash, proof);
    }
}